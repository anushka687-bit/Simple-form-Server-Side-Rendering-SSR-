<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>All Students</title>
  <link rel="stylesheet" href="/style.css"/>
</head>
<body>

<button class="theme-toggle" id="themeToggle">🌙 Dark</button>

<div class="page-wrapper">

  <div class="users-hero">
    <h1>🎓 All Students</h1>
    <p>Manage all registered students</p>
    <div class="count-badge" id="countBadge">Loading...</div>
  </div>

  <div id="apiMsg" class="api-msg" style="margin-bottom:16px;"></div>

  <div class="search-bar">
    <input type="text" id="searchInput" placeholder="🔍 Search by name, email or Student ID..."/>
    <select id="courseFilter">
      <option value="">All Courses</option>
      <option>BCA</option><option>BSc</option><option>BTech</option>
      <option>BBA</option><option>BCom</option><option>BA</option>
      <option>MCA</option><option>MSc</option><option>MTech</option><option>MBA</option>
    </select>
    <select id="genderFilter">
      <option value="">All Genders</option>
      <option value="Male">Male</option>
      <option value="Female">Female</option>
      <option value="Other">Other</option>
    </select>
  </div>

  <div class="table-wrap" id="tableWrap">
    <div class="empty-state"><p>⏳ Loading students...</p></div>
  </div>

  <!-- Edit Modal -->
  <div class="modal-overlay" id="editModal">
    <div class="modal-box">
      <h2>✏️ Edit Student</h2>
      <input type="hidden" id="edit_id"/>

      <div class="modal-row">
        <div class="modal-field">
          <label>First Name</label>
          <input type="text" id="edit_firstName"/>
        </div>
        <div class="modal-field">
          <label>Surname</label>
          <input type="text" id="edit_surname"/>
        </div>
      </div>

      <div class="modal-row">
        <div class="modal-field">
          <label>Age</label>
          <input type="number" id="edit_age"/>
        </div>
        <div class="modal-field">
          <label>Gender</label>
          <select id="edit_gender">
            <option value="Male">Male</option>
            <option value="Female">Female</option>
            <option value="Other">Other</option>
          </select>
        </div>
      </div>

      <div class="modal-field">
        <label>College Name</label>
        <input type="text" id="edit_collegeName"/>
      </div>

      <div class="modal-row">
        <div class="modal-field">
          <label>Course</label>
          <select id="edit_course">
            <option>BCA</option><option>BSc</option><option>BTech</option>
            <option>BBA</option><option>BCom</option><option>BA</option>
            <option>MCA</option><option>MSc</option><option>MTech</option>
            <option>MBA</option><option>Other</option>
          </select>
        </div>
        <div class="modal-field">
          <label>Branch</label>
          <select id="edit_branch">
            <option>Computer Science</option><option>Information Technology</option>
            <option>Artificial Intelligence</option><option>Data Science</option>
            <option>Electronics</option><option>Mechanical</option>
            <option>Civil</option><option>Finance</option><option>Marketing</option>
            <option>Other</option>
          </select>
        </div>
      </div>

      <div class="modal-row">
        <div class="modal-field">
          <label>Start Year</label>
          <input type="number" id="edit_startYear" min="2000" max="2035"/>
        </div>
        <div class="modal-field">
          <label>End Year</label>
          <input type="number" id="edit_endYear" min="2000" max="2035"/>
        </div>
      </div>

      <div class="modal-row">
        <div class="modal-field">
          <label>CGPA</label>
          <input type="number" id="edit_cgpa" step="0.01" min="0" max="10"/>
        </div>
        <div class="modal-field">
          <label>Phone</label>
          <input type="tel" id="edit_phone"/>
        </div>
      </div>

      <div class="modal-field">
        <label>Email</label>
        <input type="email" id="edit_email"/>
      </div>

      <div class="modal-row">
        <div class="modal-field">
          <label>City</label>
          <input type="text" id="edit_city"/>
        </div>
        <div class="modal-field">
          <label>Pincode</label>
          <input type="text" id="edit_pincode"/>
        </div>
      </div>

      <div class="modal-row">
        <div class="modal-field">
          <label>State</label>
          <input type="text" id="edit_state"/>
        </div>
        <div class="modal-field">
          <label>Country</label>
          <input type="text" id="edit_country"/>
        </div>
      </div>

      <div class="modal-actions">
        <button onclick="saveEdit()" class="btn-primary">Save Changes</button>
        <button onclick="closeModal()" class="btn-outline">Cancel</button>
      </div>
    </div>
  </div>

  <div class="nav" style="margin-top:24px;">
    <a href="/">&larr; Register New Student</a>
  </div>

</div>

<script>
  let allUsers = [];

  document.getElementById('themeToggle').addEventListener('click', function () {
    document.body.classList.toggle('dark');
    this.textContent = document.body.classList.contains('dark') ? '☀️ Light' : '🌙 Dark';
  });

  async function fetchUsers() {
    try {
      const res  = await fetch('/api/users');
      const json = await res.json();
      if (json.success) {
        allUsers = json.data;
        document.getElementById('countBadge').textContent = allUsers.length + ' Student(s)';
        renderTable(allUsers);
      }
    } catch (err) {
      showMsg('Failed to load: ' + err.message, false);
    }
  }

  function renderTable(users) {
    const wrap = document.getElementById('tableWrap');
    if (users.length === 0) {
      wrap.innerHTML = `<div class="empty-state"><div class="ei">📋</div><p>No students found. <a href="/">Register one!</a></p></div>`;
      return;
    }
    wrap.innerHTML = `
      <table>
        <thead>
          <tr>
            <th>ID</th><th>Name</th><th>Age</th><th>Gender</th>
            <th>College</th><th>Course</th><th>Branch</th>
            <th>Years</th><th>CGPA</th><th>Email</th>
            <th>Phone</th><th>City</th><th>Country</th><th>Actions</th>
          </tr>
        </thead>
        <tbody>
          ${users.map(u => `
            <tr>
              <td><strong>${u.studentId}</strong></td>
              <td><strong>${u.fullName}</strong></td>
              <td>${u.age}</td>
              <td><span class="gbadge ${u.gender.toLowerCase()}">${u.gender}</span></td>
              <td>${u.collegeName}</td>
              <td>${u.course}</td>
              <td>${u.branch}</td>
              <td>${u.startYear}–${u.endYear}</td>
              <td>${u.cgpa}</td>
              <td>${u.email}</td>
              <td>${u.phone}</td>
              <td>${u.city}</td>
              <td>${u.country}</td>
              <td style="white-space:nowrap;">
                <button class="action-btn edit"   onclick="openEdit(${u.id})">✏️ Edit</button>
                <button class="action-btn delete" onclick="deleteUser(${u.id})">🗑 Delete</button>
              </td>
            </tr>`).join('')}
        </tbody>
      </table>`;
  }

  function filterUsers() {
    const search = document.getElementById('searchInput').value.toLowerCase();
    const course = document.getElementById('courseFilter').value;
    const gender = document.getElementById('genderFilter').value;
    renderTable(allUsers.filter(u => {
      const ms = u.fullName.toLowerCase().includes(search) ||
                 u.email.toLowerCase().includes(search)    ||
                 u.studentId.toLowerCase().includes(search);
      const mc = course ? u.course === course : true;
      const mg = gender ? u.gender === gender : true;
      return ms && mc && mg;
    }));
  }

  document.getElementById('searchInput').addEventListener('input', filterUsers);
  document.getElementById('courseFilter').addEventListener('change', filterUsers);
  document.getElementById('genderFilter').addEventListener('change', filterUsers);

  async function deleteUser(id) {
    if (!confirm('Delete this student?')) return;
    try {
      const res  = await fetch('/api/users/' + id, { method: 'DELETE' });
      const json = await res.json();
      showMsg(json.message, json.success);
      fetchUsers();
    } catch (err) {
      showMsg('Delete failed: ' + err.message, false);
    }
  }

  function openEdit(id) {
    const u = allUsers.find(u => u.id === id);
    if (!u) return;
    document.getElementById('edit_id').value         = u.id;
    document.getElementById('edit_firstName').value  = u.firstName;
    document.getElementById('edit_surname').value    = u.surname;
    document.getElementById('edit_age').value        = u.age;
    document.getElementById('edit_gender').value     = u.gender;
    document.getElementById('edit_collegeName').value= u.collegeName;
    document.getElementById('edit_course').value     = u.course;
    document.getElementById('edit_branch').value     = u.branch;
    document.getElementById('edit_startYear').value  = u.startYear;
    document.getElementById('edit_endYear').value    = u.endYear;
    document.getElementById('edit_cgpa').value       = u.cgpa;
    document.getElementById('edit_email').value      = u.email;
    document.getElementById('edit_phone').value      = u.phone;
    document.getElementById('edit_city').value       = u.city;
    document.getElementById('edit_pincode').value    = u.pincode;
    document.getElementById('edit_state').value      = u.state;
    document.getElementById('edit_country').value    = u.country;
    document.getElementById('editModal').style.display = 'flex';
  }

  function closeModal() {
    document.getElementById('editModal').style.display = 'none';
  }

  async function saveEdit() {
    const id   = document.getElementById('edit_id').value;
    const body = {
      firstName:   document.getElementById('edit_firstName').value,
      surname:     document.getElementById('edit_surname').value,
      age:         document.getElementById('edit_age').value,
      gender:      document.getElementById('edit_gender').value,
      collegeName: document.getElementById('edit_collegeName').value,
      course:      document.getElementById('edit_course').value,
      branch:      document.getElementById('edit_branch').value,
      startYear:   document.getElementById('edit_startYear').value,
      endYear:     document.getElementById('edit_endYear').value,
      cgpa:        document.getElementById('edit_cgpa').value,
      email:       document.getElementById('edit_email').value,
      phone:       document.getElementById('edit_phone').value,
      city:        document.getElementById('edit_city').value,
      pincode:     document.getElementById('edit_pincode').value,
      state:       document.getElementById('edit_state').value,
      country:     document.getElementById('edit_country').value
    };
    try {
      const res  = await fetch('/api/users/' + id, {
        method:  'PUT',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify(body)
      });
      const json = await res.json();
      showMsg(json.message, json.success);
      closeModal();
      fetchUsers();
    } catch (err) {
      showMsg('Update failed: ' + err.message, false);
    }
  }

  function showMsg(msg, success) {
    const el = document.getElementById('apiMsg');
    el.textContent      = (success ? '✅ ' : '❌ ') + msg;
    el.style.display    = 'block';
    el.style.background = success ? 'rgba(16,185,129,0.1)' : 'rgba(220,38,38,0.1)';
    el.style.border     = `1.5px solid ${success ? 'rgba(16,185,129,0.3)' : 'rgba(220,38,38,0.3)'}`;
    el.style.color      = success ? 'var(--ok)' : 'var(--err)';
    setTimeout(() => el.style.display = 'none', 4000);
  }

  fetchUsers();
</script>
</body>
</html>